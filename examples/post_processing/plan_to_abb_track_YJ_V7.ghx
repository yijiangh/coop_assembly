                    <item name="CodeInput" type_name="gh_string" type_code="10">from abb_communication.clients.rfl_robot.communication.messages.messagetypes import *

import Rhino.Geometry as rg
from ghpythonlib.treehelpers import list_to_tree, tree_to_list

from abb_communication.geometry import Frame
from scriptcontext import sticky as st
import math
import time
from threading import Thread

robot = st["rfl_robot"]
robot_speed = float(rob_speed)

if robot:    
    robot.comm.float_arbitrary = int(rob_num)
    print("robot found")
    
    
    if rob_speed == 1:
        print "robot speed: fast"
        robot_speed = 250
        robot.comm.send_set_speed(robot_speed, 15)
    if rob_speed == 2:
        print "robot speed: mid"
        robot_speed = 150
        robot.comm.send_set_speed(robot_speed, 5)
    if rob_speed == 3:
        print "robot speed: slow"
        robot_speed = 25
        robot.comm.send_set_speed(robot_speed)
    
    
    if robot.comm.running:
        print "ROBOT IS ONLINE"
        
#        joints_print = robot.comm.get_current_pose_joint()
#        print "current joints:", joints_print
#        joints_deg = [math.degrees(j) for j in joints_print]
#        joints_deg = [round(x, 2) for x in joints_deg]
#        print "current pose:", joints_deg
        
    else:
        print "ROBOT IS OFFLINE"
        
        
