                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import Rhino.Geometry.Plane as Plane
import Rhino.Geometry.Point3d as Point3d
import Rhino.Geometry.Vector3d as Vector3d
import Rhino.Geometry.Quaternion as Quat
import Rhino.Geometry.Line as Line
import Rhino.Geometry.Transform as Transform
import Grasshopper.DataTree as DataTree # Add, AddRange(list, GHPath(i, j))
import Grasshopper.Kernel.Data.GH_Path as GHPath
import System

from ghpythonlib.treehelpers import list_to_tree, tree_to_list

import json
from compas.geometry import Frame
from compas.geometry import scale_points
from compas_ghpython import draw_pipes, draw_frame
from itertools import islice

######################################

def pose_from_frame(frame, scale=1.0):
    """Returns a PyBullet pose from a frame.
    Parameters
    ----------
    frame : :class:`compas.geometry.Frame`
    Returns
    -------
    point, quaternion : tuple
    """
    return ([v*scale for v in frame.point], frame.quaternion.xyzw)


def frame_from_pose(pose, scale=1.0):
    """Returns a frame from a PyBullet pose.
    Parameters
    ----------
    point, quaternion : tuple
    Returns
    -------
    :class:`compas.geometry.Frame`
    """
    point, (x, y, z, w) = pose
    return Frame.from_quaternion([w, x, y, z], point=[v*scale for v in point])

#########################################

with open(result_file_path) as json_file:
    data = json.load(json_file)

print('file_name: {}'.format(data['problem']))
try:
    print('write_time: {}'.format(data['write_time']))
    print('parameters: {}'.format(data['parameters']))
except:
    pass

sp_id_from_process_tag = {
    'transfer' : 0,
    'place_approach' : 1,
    'place_retreat' : 2,
    'transit' : 3,
}

# parse trajectories and EE paths (indexed by sequence index)
paths = DataTree[System.Double]()
ee_paths = DataTree[Plane]()
elements = DataTree[System.Int32]()
tags = DataTree[System.String]()
grasps = DataTree[Plane]()
for seq_id, e_trajs in enumerate(data['plan']):
    if seq_id == 0 and 'transit' == e_trajs[0]['tag']:
        del e_trajs[0]
    for traj in e_trajs:
        sp_id = sp_id_from_process_tag[traj['tag']]
        path = traj['path']
        epath = traj['link_path'][ee_link_name]
        for t_id, (conf, epose) in enumerate(zip(path, epath)):
            conf = [float(v) for v in conf]
            paths.AddRange(conf, GHPath(seq_id, sp_id, t_id))
            ee_paths.Add(draw_frame(frame_from_pose(epose, scale)), GHPath(seq_id, sp_id, t_id))
            
        if traj['element'] is not None: 
            elements.Add(traj['element'], GHPath(seq_id, sp_id))
        else:
            elements.Add(-1000, GHPath(seq_id, sp_id))
        tags.Add(traj['tag'], GHPath(seq_id, sp_id))
        
        for attach_data in traj['attachments']:
            g_frame = frame_from_pose(attach_data['grasp_pose'], scale=scale)
            grasps.Add(draw_frame(g_frame), GHPath(seq_id, sp_id))

# reconstruct shape (indexed by bar index)
axispts_from_index = DataTree[Point3d]()
radius = DataTree[System.Double]()
goal_poses = DataTree[Plane]()
for e_id, edata in data['element_from_index'].items():
    radius.Add(edata['radius']*scale, GHPath(int(e_id)))
    
    goal_frame = frame_from_pose(edata['goal_pose']['value'], scale=scale)
    goal_poses.Add(draw_frame(goal_frame), GHPath(int(e_id)))
    
    scaled_pts = scale_points(edata['axis_endpoints'], scale)
    for i in range(2):
        axispts_from_index.Add(Point3d(*scaled_pts[i]), GHPath(int(e_id)))</item>
