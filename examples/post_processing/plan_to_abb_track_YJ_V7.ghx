              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
from compas_fab.robots import Configuration

if robot:
    joint_values = [a1, a2, a3, a4, a5, a6]
    joint_names = robot.get_configurable_joint_names()
    configuration = Configuration.from_prismatic_and_revolute_values([x], 
        [math.radians(a) for a in joint_values])
    print configuration</item>
