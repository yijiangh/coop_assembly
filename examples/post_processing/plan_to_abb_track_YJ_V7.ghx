                    <item name="CodeInput" type_name="gh_string" type_code="10">import rhinoscriptsyntax as rs
import Rhino.Geometry.Plane as Plane
import Rhino.Geometry.Point3d as Point3d
import Rhino.Geometry.Vector3d as Vector3d
import Rhino.Geometry.Quaternion as Quat
import Grasshopper.DataTree as DataTree # Add, AddRange(list, GHPath(i, j))
import Grasshopper.Kernel.Data.GH_Path as GHPath
import System
from System.Collections.Generic import List

from ghpythonlib.treehelpers import list_to_tree, tree_to_list
import os
import json
##############################

import clr
# https://ironpython.net/documentation/dotnet/dotnet.html

try:
    clr.AddReferenceToFileAndPath("C:\Program Files\Rhino 6\Plug-ins\Karamba\Karamba.gha")
    clr.AddReferenceToFileAndPath("C:\Program Files\Rhino 6\Plug-ins\Karamba\KarambaCommon.dll")
except:
    clr.AddReferenceToFileAndPath("C:\Program Files\Rhino 6\Plug-ins\Karamba.gha")
    clr.AddReferenceToFileAndPath("C:\Program Files\Rhino 6\Plug-ins\KarambaCommon.dll")

import feb # Karamba's C++ library (undocumented in the API)
import Karamba.Models.Model as Model
import Karamba.GHopper.Models.GH_Model as GH_Model
#
import Karamba
import Karamba.Elements.ModelTruss as Truss
from Karamba.Geometry import Point3, Line3, Vector3
from Karamba.CrossSections import CroSec
from Karamba.Supports import Support
from Karamba.Loads import Load
#
from Karamba.Utilities import MessageLogger, UnitsConversionFactories
import KarambaCommon
#
import System
from System import GC
from System.Collections.Generic import List

#####################################
# add path to conmech script folder
import os, sys 
sys.path.append(os.path.join(conmech_dir, "src", "pyconmech", "frame_analysis"))
#from io_base import Model
import io_base
import karamba_io
reload(io_base)
reload(karamba_io)
from karamba_io import KarambaModel
from io_base import LoadCase, GravityLoad

#####################################

with open(os.path.join(result_file_path), 'r') as f:
    data = json.load(f)
    conmech_data = data['conmech_model']

print('{} | {}'.format(conmech_data["model_name"], conmech_data['generate_time']))
km = KarambaModel.from_data(conmech_data)
#lc = LoadCase.from_data(data['loadcases']['0'])

model = km.to_karamba(LoadCase(gravity_load=GravityLoad([0,0,-1])), limit_dist=limit_distance)

## calculate Th.I response
#logger = MessageLogger();
#k3d = KarambaCommon.Toolkit();
#max_disp = clr.Reference[List[float]]()
#out_g = clr.Reference[List[float]]()
#out_comp = clr.Reference[List[float]]()
#message = clr.Reference[str]()
#model = k3d.Algorithms.AnalyzeThI(model, max_disp, out_g, out_comp, message);
#
#ucf = UnitsConversionFactories.Conv();
#cm = ucf.cm();
#print "max disp: {} {}".format(cm.toUnit(max_disp.Value[0]), cm.unitB)
#
Model_out = Karamba.GHopper.Models.GH_Model(model);
#
#from Karamba.GHopper.CrossSections import GH_CrossSection
#a = List[GH_CrossSection]([GH_CrossSection(cs.to_karamba()) for cs in km.crosssecs])

fem_data = conmech_data['fem_element_from_bar_id']
fem_element_from_bar_id = DataTree[int]()
for i, es in fem_data.items():
    if int(i) &gt;= 0:
        fem_element_from_bar_id.AddRange(es, GHPath(int(i)))

deform_history = [trans[1] for trans in data['stiffness_history']]

if 'progression_stiffness_history' in data:
    progression_deform_history = [trans[1] for trans in data['progression_stiffness_history']]

if 'progression_sequence' in data:
    progression_sequence = [id for id in data['progression_sequence']]

element_sequence = DataTree[System.Int32]()
for seq_id, e_trajs in enumerate(data['plan']):
    if seq_id == 0:
        del e_trajs[0]
    for sp_id, traj in enumerate(e_trajs):
        if traj['element'] is not None: 
            element_sequence.Add(traj['element'], GHPath(seq_id, sp_id))
        else:
            element_sequence.Add(-1000, GHPath(seq_id, sp_id))</item>
