#201219_conversion to abb format/units from yijiang, applied per single sequence
PROCESS_NAME_FROM_ID = {
    0 : 'transit', 1 : 'place_approach', 2 : 'place_retreat', 3 : 'transfer',
}

def convert_to_ECL_conf(joints):
    joints.append(joints.pop(0))
    joints.extend([0,0])
    # convert joint to degrees
    joints[:6] = [math.degrees(item) for item in joints[:6]]
    # conver to meters
    joints[6] = joints[6] * 1000
    return joints

transfer = []
place_approach = []
place_retreat = []
transit = []
for ghpath in joints_sequence.Paths:
    seq_id, process_id, conf_id = list(ghpath.Indices)
    # I convert the configuration to your format here!
    conf = convert_to_ECL_conf(list(joints_sequence.Branch(ghpath)))
#    print conf
    if process_id == 0:
        transfer.append(conf)
    elif process_id == 1:
        place_approach.append(conf)
    elif process_id == 2:
        place_retreat.append(conf)
    elif process_id == 3:
        transit.append(conf)
place_approach_reverse = place_approach[::-1]

if send_joints_sequence:
#    robot.comm.set_speed_mid()
#    robot.comm.send_set_speed(robot_speed)
    robot.comm.send_stop()
    robot.comm.send_close_gripper() #opens gripper jaws
    robot.comm.send_stop()
    robot.comm.send_open_gripper() #closes gripper jaws
    robot.comm.send_stop()
    
    robot.comm.send_axes_absolute_list(transfer, int_arr = None)
    time.sleep(1)
    robot.comm.send_axes_absolute_list(place_approach, int_arr = None)
    robot.comm.send_stop()
    
    robot.comm.send_axes_absolute_list(place_approach_reverse, int_arr = None)
    robot.comm.send_stop()
    robot.comm.send_axes_absolute_list(place_approach, int_arr = None)
    robot.comm.send_stop()

    robot.comm.send_close_gripper() #opens gripper jaws
    robot.comm.send_stop()
    
    robot.comm.send_axes_absolute_list(place_retreat, int_arr = None)
    time.sleep(1)
    robot.comm.send_axes_absolute_list(transit, int_arr = None)
    time.sleep(1)
    robot.comm.send_open_gripper() #closes gripper jaws
        
        
if open_gripper:
    robot.comm.send_close_gripper()
    
if close_gripper:
    robot.comm.send_open_gripper()
    
#==================================================================

