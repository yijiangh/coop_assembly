#    print(joints_abb)
#    robot.comm.send_axes_absolute(joints_abb, int_arr = None)
    
    
#get data tree into list of lists of floats
#joints_abb_list = tree_to_list(joints_abb_list, 0)
#joints_abb_list_2 = []
#for joints_abb in joints_abb_list:
#    joints_abb = [float(item) for item in joints_abb]
#    joints_abb_list_2.append(joints_abb)
    

    
    
    
#==================================================================


##clean sequence tree
#joints_sequence = tree_to_list(joints_sequence, 0)
#joints_abb_sequence = []
#
#for sequence in joints_sequence:
#    move_new = []
#    for move in sequence:
